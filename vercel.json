{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "functions": {
    "app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/cron/disparar-lembretes/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "app/api/cron/cleanup-audios/route.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/cron/disparar-lembretes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/calcular-padroes",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/lembretes-compromissos",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/insights-mensais",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/relatorio-diario?slot=17h",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/relatorio-diario?slot=23h",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-audios",
      "schedule": "0 3 * * *"
    }
  ]
}
